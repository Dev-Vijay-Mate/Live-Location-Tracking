{
  "name": "live-location-tracking-backend",
  "version": "1.0.0",
  "description": "Real-time backend system for 3D Live Location Tracking (Express, PostgreSQL, WebSockets)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "node --test tests/**/*.test.js",
    "simulate": "node simulator/simulator.js",
    "db:migrate": "node src/db/migrate.js",
    "db:seed": "node src/db/seed.js"
  },
  "keywords": [
    "location-tracking",
    "real-time",
    "websockets",
    "express",
    "postgresql",
    "nsg"
