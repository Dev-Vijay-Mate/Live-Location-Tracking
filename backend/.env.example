# Server Configuration
PORT=5001
NODE_ENV=development

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=live_location_tracking
DB_USER=postgres
DB_PASSWORD=your_local_password

# PostgreSQL Connection Pool Settings
DB_MAX_CONNECTIONS=20
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000

# Location & Device Settings
DEVICE_STALE_TIMEOUT_SECONDS=30

# WebSocket Configuration
WS_PATH=/ws

# CORS Configuration (Member 3 Frontend - React/Vite)
CORS_ORIGIN=http://localhost:5173

# Synthetic Movement Simulator Configuration (npm run simulate)
SIMULATOR_BUILDING_ID=BUILDING_001
SIMULATOR_INTERVAL_MS=2000
SIMULATOR_DEVICES=DEVICE_001,DEVICE_002,DEVICE_003,DEVICE_004

