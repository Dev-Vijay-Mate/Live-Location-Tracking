# ============================================================
# Live Location Tracking System - Backend Environment Config
# ============================================================

PROJECT_NAME="NSG CQB Live Location Tracking System"
API_V1_STR="/api"
DEBUG=True

# Server Configuration
HOST="0.0.0.0"
PORT=8000

# CORS Allowed Origins (Comma separated)
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# PostgreSQL Database Credentials
# Format: postgresql+asyncpg://<USER>:<PASSWORD>@<HOST>:<PORT>/<DB_NAME>
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/live_location_db"

# Fallback SQLite DB for offline/local development without running PostgreSQL
USE_SQLITE_FALLBACK=True
SQLITE_URL="sqlite+aiosqlite:///./test.db"

# Tracking & Stale Thresholds (in seconds)
STALE_THRESHOLD_SECONDS=30
OFFLINE_THRESHOLD_SECONDS=120
