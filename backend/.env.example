# ============================================================
# Live Location Tracking System - Unified Backend Environment
# Primary Backend: Node.js (Express, pg, ws)
# ============================================================

# Server Configuration
PORT=8000
NODE_ENV=development

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=live_location_tracking
DB_USER=postgres
DB_PASSWORD=your_local_password

# PostgreSQL Connection Pool Settings
DB_MAX_CONNECTIONS=20
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000

# Tracking & Stale Thresholds (in seconds)
DEVICE_STALE_TIMEOUT_SECONDS=30
STALE_THRESHOLD_SECONDS=30
OFFLINE_THRESHOLD_SECONDS=120

# WebSocket Configuration (serves both /ws and /ws/locations)
WS_PATH=/ws

# CORS Configuration (Member 3 Frontend - React/Vite dev server)
CORS_ORIGIN=http://localhost:3000

# Synthetic Movement Simulator Configuration (npm run simulate)
SIMULATOR_BUILDING_ID=BUILDING_001
SIMULATOR_INTERVAL_MS=2000
SIMULATOR_DEVICES=DEVICE_001,DEVICE_002,DEVICE_003,DEVICE_004
